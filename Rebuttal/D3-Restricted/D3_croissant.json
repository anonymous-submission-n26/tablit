  "@type": "sc:Dataset",
  "name": "TabLit-D3",
  "description": "D3 cohort of TabLit (Indian River district operational records): Grade 1-2 panel (2,088 students) and Grade 3 ELA cohort (1,137 students), with student-level demographics (gender, ethnicity, ELL/LEP, ESE, Section 504, gifted, lunch status, homelessness, home language). RESTRICTED DISTRIBUTION: D3 consists of anonymized student-level operational records from a Florida school district, provided under a district-level data sharing agreement that does not permit public redistribution. Files are disclosed to the NeurIPS review committee for verification. SHA-256 checksums below commit publicly to the exact bytes the committee receives.",
  "url": "https://github.com/anonymous-submission-n26/tablit",
  "license": "Restricted district data sharing agreement; no public redistribution.",
  "creator": [
    {
      "@type": "sc:Person",
      "name": "Anonymous Author"
    }
  ],
  "datePublished": "2026-07-24",
  "version": "1.0.0",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "citeAs": "Anonymous Author. TabLit: A Demographic-Aware Benchmark for Modeling Early Literacy Outcomes.",
  "rai:personalSensitiveInformation": "De-identified student-level records; coded student and school identifiers only; no names, dates of birth, or direct identifiers. Literal school names are withheld from these files.",
